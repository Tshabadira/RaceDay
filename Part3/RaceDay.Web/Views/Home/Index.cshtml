@model HomeIndexViewModel
@{
    ViewData["Title"] = "Upcoming events";
}

<section class="rd-hero">
    <h1>Every road event in South Africa. One start line.</h1>
    <p>Browse upcoming running, walking and cycling events, choose a category and enter in a few clicks.</p>
</section>

@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}

<form method="get" asp-controller="Home" asp-action="Index" class="row g-2 align-items-end mb-4">
    <div class="col-md-4">
        <label class="form-label" for="search">Search</label>
        <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event name or place" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="province">Province</label>
        <select id="province" name="province" class="form-select">
            <option value="">All provinces</option>
            @foreach (var p in Model.Provinces)
            {
                <option value="@p" selected="@(p == Model.Province)">@p</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="type">Event type</label>
        <select id="type" name="type" class="form-select">
            <option value="">Run, walk or cycle</option>
            <option value="run" selected="@(Model.Type == "run")">Running</option>
            <option value="walk" selected="@(Model.Type == "walk")">Walking</option>
            <option value="cycle" selected="@(Model.Type == "cycle")">Cycling</option>
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="rd-panel text-center">
        <h2>No events found</h2>
        <p class="mb-0">Try a different filter, or check back soon.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card rd-card h-100">
                    @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                    {
                        <img src="@ev.BannerImageUrl" class="rd-card-img" alt="Banner for @ev.EventName" />
                    }
                    else
                    {
                        <div class="rd-card-img rd-card-placeholder">RACEDAY</div>
                    }
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5">@ev.EventName</h2>
                        <p class="text-muted mb-2">@ev.EventDate.ToString("dd MMM yyyy") - @ev.Location, @ev.Province</p>
                        <div class="mb-3">
                            @foreach (var c in ev.Categories)
                            {
                                <span class="rd-chip">@Display.Distance(c.DistanceKM) @c.EventType</span>
                            }
                        </div>
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@ev.EventID" class="btn btn-primary mt-auto">View details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
