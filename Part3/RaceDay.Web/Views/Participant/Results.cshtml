@model List<ResultDto>
@{
    ViewData["Title"] = "My results";
}

<h1>My results</h1>
<p class="text-muted">Your race history. Results are captured by the organiser after each event.</p>

@if (!Model.Any())
{
    <div class="rd-panel text-center">
        <h2>No results yet</h2>
        <p class="mb-0">Your results will appear here once an organiser has captured them.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Overall position</th><th>Category position</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.EventName</td>
                        <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@r.CategoryName</td>
                        <td class="rd-mono">@Display.Time(r.FinishTime)</td>
                        <td>
                            @if (r.OverallPosition.HasValue)
                            {
                                <span>@Display.Ordinal(r.OverallPosition.Value) of @r.TotalFinishers finishers</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>
                            @if (r.CategoryPosition.HasValue)
                            {
                                <span>@Display.Ordinal(r.CategoryPosition.Value) of @r.CategoryFinishers</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td><partial name="_StatusBadge" model="r.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
