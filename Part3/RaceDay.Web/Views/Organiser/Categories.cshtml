@model CategoriesViewModel
@{
    ViewData["Title"] = "Categories";
    var ev = Model.Event;
}

<p><a asp-action="Events">&larr; My events</a></p>
<h1>Categories</h1>
<p class="text-muted">@ev.EventName - @ev.EventDate.ToString("dd MMM yyyy")</p>

<div class="rd-panel">
    <h2>Current categories</h2>
    @if (!ev.Categories.Any())
    {
        <p class="mb-0">No categories yet. Add the first one below.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Name</th><th>Distance</th><th>Type</th><th>Entry fee</th><th>Max participants</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in ev.Categories)
                    {
                        <tr>
                            <td>@c.CategoryName</td>
                            <td>@Display.Distance(c.DistanceKM)</td>
                            <td>@c.EventType</td>
                            <td>@Display.Money(c.EntryFee)</td>
                            <td>@c.MaxParticipants</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-outline-secondary btn-sm" asp-action="EditCategory" asp-route-id="@c.CategoryID" asp-route-eventId="@ev.EventID">Edit</a>
                                <form asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                                    <input type="hidden" name="id" value="@c.CategoryID" />
                                    <input type="hidden" name="eventId" value="@ev.EventID" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="rd-panel">
    <h2>Add a category</h2>
    <form asp-action="AddCategory" method="post" class="row g-3">
        <input type="hidden" name="EventID" value="@ev.EventID" />
        <div class="col-md-4">
            <label class="form-label" for="CategoryName">Category name</label>
            <input id="CategoryName" name="CategoryName" class="form-control" maxlength="100" placeholder="21km Half Marathon" required />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="DistanceKM">Distance (km)</label>
            <input id="DistanceKM" name="DistanceKM" type="number" step="0.01" min="0.01" max="999.99" class="form-control" required />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="EventType">Type</label>
            <select id="EventType" name="EventType" class="form-select">
                <option value="run">Run</option>
                <option value="walk">Walk</option>
                <option value="cycle">Cycle</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="EntryFee">Entry fee (R)</label>
            <input id="EntryFee" name="EntryFee" type="number" step="0.01" min="0" value="0" class="form-control" required />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="MaxParticipants">Max participants</label>
            <input id="MaxParticipants" name="MaxParticipants" type="number" min="1" value="100" class="form-control" required />
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Add category</button>
        </div>
    </form>
</div>
