@model EventEnrolmentsViewModel
@{
    ViewData["Title"] = "Enrolments";
    var ev = Model.Event;
}

<p><a asp-action="Events">&larr; My events</a></p>
<h1>Enrolments</h1>
<p class="text-muted">@ev.EventName - @ev.EventDate.ToString("dd MMM yyyy")</p>

@if (!Model.Enrolments.Any())
{
    <div class="rd-panel text-center"><h2>Nobody has enrolled yet</h2></div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Race number</th><th>Participant</th><th>Category</th><th>Entered on</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    <tr>
                        <td class="rd-mono">@e.RaceNumber</td>
                        <td>@e.ParticipantName</td>
                        <td>@e.CategoryName</td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td><partial name="_StatusBadge" model="e.PaymentStatus" /></td>
                        <td class="text-end">
                            <form asp-action="SetPayment" method="post">
                                <input type="hidden" name="enrolmentId" value="@e.EnrolmentID" />
                                <input type="hidden" name="eventId" value="@ev.EventID" />
                                @if (e.PaymentStatus == "Paid")
                                {
                                    <input type="hidden" name="status" value="Pending" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Set to pending</button>
                                }
                                else
                                {
                                    <input type="hidden" name="status" value="Paid" />
                                    <button type="submit" class="btn btn-success btn-sm">Confirm</button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
