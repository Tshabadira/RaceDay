@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}

<h1>Edit category</h1>

<div class="rd-panel">
    <form asp-action="EditCategory" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <input type="hidden" asp-for="CategoryID" />
        <input type="hidden" asp-for="EventID" />
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CategoryName" class="form-label"></label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="DistanceKM" class="form-label"></label>
                <input asp-for="DistanceKM" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="DistanceKM" class="text-danger"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option value="run">Run</option>
                    <option value="walk">Walk</option>
                    <option value="cycle">Cycle</option>
                </select>
                <span asp-validation-for="EventType" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3 mb-3">
                <label asp-for="EntryFee" class="form-label"></label>
                <input asp-for="EntryFee" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="EntryFee" class="text-danger"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="MaxParticipants" class="form-label"></label>
                <input asp-for="MaxParticipants" type="number" class="form-control" />
                <span asp-validation-for="MaxParticipants" class="text-danger"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a class="btn btn-outline-secondary" asp-action="Categories" asp-route-eventId="@Model.EventID">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
